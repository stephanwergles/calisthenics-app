# Lokal: npm run db:up startet Postgres auf Port 5433 (siehe docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/calisthenics

# Zufälliger, langer Wert – z. B. `openssl rand -hex 32`. Auf dem Server einen eigenen setzen.
PAYLOAD_SECRET=

# Öffentliche Adresse der App (Server: https://…)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
