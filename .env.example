# Lokal: npm run db:up startet Postgres auf Port 5433 (siehe docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/calisthenics

# Zufälliger, langer Wert – z. B. `openssl rand -hex 32`. Auf dem Server einen eigenen setzen.
PAYLOAD_SECRET=

# Öffentliche Adresse der App (Server: https://…)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Mails (Bestätigung der Registrierung, „Passwort vergessen“) über Resend. Leer = Mails nur im Log.
RESEND_API_KEY=
# Absender – Domain muss bei Resend verifiziert sein
MAIL_FROM=lever@blank-studio.de

# Sign in with Apple: erlaubte Bundle-IDs (Empfänger des Apple-Tokens), kommagetrennt
# APPLE_BUNDLE_IDS=de.offected.lever,de.offected.lever.dev
